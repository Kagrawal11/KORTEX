# Copy to .env next to docker-compose.yml, fill in real values, chmod 600.
# Never commit the real .env — it is already gitignored.

# ─── Images ──────────────────────────────────────────────────────────────────
# Your GitHub username/org, LOWERCASE (GHCR rejects uppercase tags).
GHCR_OWNER=

# ─── Public hostname and gate ────────────────────────────────────────────────
# The DuckDNS (or other) hostname pointed at this machine's public IP.
# Caddy issues the Let's Encrypt certificate for exactly this name.
KORTEX_HOST=kortex-yourname.duckdns.org

# bcrypt hash for the single HTTP basic-auth user (username: kortex).
# Generate with:
#   docker run --rm caddy:2-alpine caddy hash-password --plaintext 'your-password'
# Paste the output verbatim, including the leading $2a$...
# Verify it survived: docker compose exec caddy env | grep KORTEX_BASIC_AUTH_HASH
KORTEX_BASIC_AUTH_HASH=

# ─── Database (Aiven for MySQL, free plan) ───────────────────────────────────
# Note: no createDatabaseIfNotExist — Aiven provisions `defaultdb` for you and
# does not grant CREATE DATABASE.
DB_URL=jdbc:mysql://HOST:PORT/defaultdb?sslMode=REQUIRED&serverTimezone=UTC
DB_USER=avnadmin
DB_PASSWORD=

# ─── JVM ─────────────────────────────────────────────────────────────────────
# Required on a 1 GB host: the JVM's default heap sizing leaves nothing for
# Chromium, which needs 400-600 MB of its own.
JAVA_TOOL_OPTIONS=-Xmx320m -XX:MaxMetaspaceSize=192m

# ─── Optional: LLM element descriptions and self-healing ─────────────────────
# Leave blank to keep cost at zero — LlmClient falls back to a built-in
# heuristic description generator and makes no network calls.
MINI_AUTOMATION_LLM_API_KEY=

# ─── Optional: execution report email delivery ───────────────────────────────
# Leave MINI_AUTOMATION_MAIL_HOST blank to keep the feature disabled; the
# backend detects that and returns a clear error instead of hanging on an
# empty SMTP host. Use a Gmail App Password, never your account password.
MINI_AUTOMATION_MAIL_HOST=
MINI_AUTOMATION_MAIL_PORT=587
MINI_AUTOMATION_MAIL_USERNAME=
MINI_AUTOMATION_MAIL_PASSWORD=
MINI_AUTOMATION_MAIL_FROM=
